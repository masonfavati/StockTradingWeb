# Copy this file to backend/.env. NEVER commit backend/.env or actual API secrets.
# Local-only PostgreSQL credentials are defined in compose.yaml.
DATABASE_URL=postgresql+psycopg://stocktradingweb:local_development_only@127.0.0.1:5433/stocktradingweb

# Use free Alpaca paper-trading API credentials from your own Alpaca account.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

# The website can boot with the market stream disabled.
# For real IEX trades: set true and feed=iex after adding credentials.
MARKET_DATA_ENABLED=false
MARKET_DATA_FEED=iex
MARKET_DATA_SYMBOL=AAPL
